SECRET_KEY=replace-with-a-long-random-secret
# Use a persistent random key, different from SECRET_KEY, to encrypt authenticator secrets.
TOTP_ENCRYPTION_KEY=replace-with-a-different-long-random-secret
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=devmonitor
MYSQL_USER=root
MYSQL_PASSWORD=
# XAMPP commonly uses root without a password on a local development install.
COOKIE_SECURE=false
# Gmail requires two-step verification and an app password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=devmonitor.system@gmail.com
MAIL_PASSWORD=replace-with-google-app-password
MAIL_DEFAULT_SENDER=devmonitor.system@gmail.com
MAIL_USE_TLS=true
MAIL_TIMEOUT=15
# Public application origin used in device enrollment QR codes (set for remote scans).
# PUBLIC_BASE_URL=https://monitor.example.com
# Optional alternative:
# DATABASE_URL=mysql+pymysql://devmonitor_app:password@127.0.0.1:3306/devmonitor?charset=utf8mb4
