SECRET_KEY=example-secret-key-change-me
# Use a persistent random key, different from SECRET_KEY, to encrypt authenticator secrets.
TOTP_ENCRYPTION_KEY=example-encryption-key-change-me
MYSQL_HOST=db.example.com
# Set this to the port XAMPP is listening on (for example, 3307).
MYSQL_PORT=3306
MYSQL_DATABASE=example_database
MYSQL_USER=example_user
MYSQL_PASSWORD=example-password
# XAMPP commonly uses root without a password on a local development install.
COOKIE_SECURE=true
# Gmail requires two-step verification and an app password.
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=example-mail-password
MAIL_DEFAULT_SENDER=your-email@example.com
MAIL_USE_TLS=true
MAIL_TIMEOUT=15
# Administrator mailbox: the admin account uses this address and receives a 6-digit
# sign-in code there after entering its password (default shown).
# ADMIN_EMAIL=devmonitor.system@gmail.com
# Public application origin used in device enrollment QR codes (set for remote scans).
# PUBLIC_BASE_URL=https://app.example.com
# Optional alternative:
# DATABASE_URL=mysql+pymysql://example_user:example-password@db.example.com:3306/example_database?charset=utf8mb4
# Where prebuilt agent downloads are published by the "Publish agents" GitHub Actions
# workflow. Needed on hosts that cannot store or build them (e.g. Vercel).
# AGENT_RELEASE_URL=https://github.com/OWNER/REPO/releases/download/agents-latest
